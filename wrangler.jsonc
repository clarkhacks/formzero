{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "formzero",
	"compatibility_date": "2025-04-04",
	"compatibility_flags": [
        "nodejs_compat"
    ],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "formzero",
			"database_id": "9f118a3d-a40e-4d16-885d-440faafdbd51",
		}
	],
	"r2_buckets": [
		{
			"binding": "UPLOADS",
			"bucket_name": "formzero-uploads"
		}
	]
}